rules_version = '2';

// =============================================================================
// KPI consulting — Firestore аюулгүй байдлын дүрэм (АЮУЛГҮЙ ХУВИЛБАР)
// =============================================================================
// Firebase консол → Firestore Database → Rules хэсэгт БҮГДИЙГ нь хуулж тавиад
// Publish дарна.
//
// Урьдчилсан нөхцөл:
//   1) Authentication → Email/Password идэвхжсэн, админ хэрэглэгч үүсгэсэн байх.
//   2) Эхний админыг Firestore-д "admins" коллекц үүсгэж, БАРИМТ (document)
//      ID нь тухайн админы UID байхаар нэг doc нэмнэ (ж: {ok:true}).
//      Дараагийн админыг админ хэсгээс нэмж болно.
//
// Логик:
//   • content/*      — нийтийн контент. Хэн ч УНШИНА, зөвхөн админ БИЧНЭ.
//   • submissions/*  — зочны хүсэлт/захиалга/бүртгэл (хувийн мэдээлэлтэй).
//                      Зочид зөвхөн ҮҮСГЭНЭ, зөвхөн админ УНШИХ/УСТГАНА.
//   • public/taken_slots — захиалагдсан цаг (огноо+цаг, PII биш). Хэн ч унших/бичих.
//   • analytics/*    — өдөр тутмын хуудас үзэлтийн тоолуур (PII биш).
//                      Хэн ч өсгөнө, зөвхөн админ УНШИНА.
//   • admins/*       — админы UID жагсаалт. Зөвхөн одоогийн админ удирдана.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Тухайн хэрэглэгч админ мөн эсэх (admins коллекцид UID нь байгаа эсэх)
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validAdminDoc() {
      return request.resource.data.keys().hasOnly([
          'ok','email','name','createdBy','createdAt'
        ])
        && request.resource.data.ok == true;
    }

    // Нийтийн контент — хэн ч унших, зөвхөн админ засах
    match /content/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Зочны илгээлт (хувийн мэдээлэл) — зочид зөвхөн үүсгэх, зөвхөн админ унших/устгах.
    // Спам/хог өгөгдлөөс сэргийлж kind болон талбаруудыг баталгаажуулна.
    match /submissions/{doc} {
      allow create: if request.resource.data.kind in ['quote', 'booking', 'user']
        && request.resource.data.keys().hasOnly([
             'kind','at','name','email','phone','org',
             'product','productKey','answers','date','time','paid','role'
           ])
        && (!('answers' in request.resource.data) || request.resource.data.answers.size() <= 40)
        // Талбар бүрд уртын хязгаар — хязгааргүй том өгөгдөл бичихээс сэргийлнэ
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 120)
        && (!('email' in request.resource.data) || request.resource.data.email.size() <= 200)
        && (!('phone' in request.resource.data) || request.resource.data.phone.size() <= 40)
        && (!('org' in request.resource.data) || request.resource.data.org.size() <= 200)
        && (!('role' in request.resource.data) || request.resource.data.role.size() <= 120)
        // Бүртгэл нь ямар ч тохиолдолд төлбөртэй эрх ОЛГОХГҮЙ
        && (!('paid' in request.resource.data) || request.resource.data.kind == 'booking');
      // Popup цонхны бүртгэл — админаас тохируулсан формоор зочин бүртгүүлнэ
      allow create: if request.resource.data.kind == 'popup'
        && request.resource.data.keys().hasOnly([
             'kind','at','title','formTitle','name','email','phone','answers'
           ])
        && (!('answers' in request.resource.data) || request.resource.data.answers.size() <= 40)
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 120)
        && (!('email' in request.resource.data) || request.resource.data.email.size() <= 200)
        && (!('phone' in request.resource.data) || request.resource.data.phone.size() <= 40)
        && (!('title' in request.resource.data) || request.resource.data.title.size() <= 300)
        && (!('formTitle' in request.resource.data) || request.resource.data.formTitle.size() <= 200);
      // QPay худалдан авалтын бүртгэл — ЗӨВХӨН АДМИН бичнэ.
      // Өмнө нь зочин бичдэг байсан тул хэн ч дурын дүнтэй хуурамч
      // "худалдан авалт" үүсгэж, орлогын тайланг бохирдуулж чаддаг байв.
      // Жинхэнэ эх сурвалж нь QPay merchant portal.
      allow create: if isAdmin()
        && request.resource.data.kind == 'payment'
        && request.resource.data.keys().hasOnly([
             'kind','at','invoiceId','paymentId','amount','product',
             'name','email','phone'
           ])
        && request.resource.data.invoiceId is string
        && request.resource.data.invoiceId.size() <= 64
        && request.resource.data.amount is number;
      // Уншигчийн санал хүсэлт — нийтлэлийн доорх шууд мессеж
      allow create: if request.resource.data.kind == 'feedback'
        && request.resource.data.keys().hasOnly([
             'kind','at','name','email','message','product'
           ])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 2
        && request.resource.data.message.size() <= 2000
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 120)
        && (!('email' in request.resource.data) || request.resource.data.email.size() <= 200)
        && (!('product' in request.resource.data) || request.resource.data.product.size() <= 300);
      // Мэдээллийн захиалга — зөвхөн и-мэйл хаяг (хамгийн бага өгөгдөл)
      allow create: if request.resource.data.kind == 'subscribe'
        && request.resource.data.keys().hasOnly(['kind','at','email'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 200;
      allow create: if isAdmin()
        && request.resource.data.kind == 'crm'
        && request.resource.data.keys().hasOnly([
             'kind','at','contactId','activityType','subject','message',
             'status','occurredAt','byName','byEmail'
           ])
        && request.resource.data.contactId is string
        && request.resource.data.activityType in ['email','call','note','status']
        && (!('subject' in request.resource.data) || request.resource.data.subject is string)
        && (!('message' in request.resource.data) || request.resource.data.message is string);
      allow read, update, delete: if isAdmin();
    }

    // Бүртгэлийн давхардлын индекс — и-мэйл/утасны SHA-256 хэш л агуулна.
    //   • get: тодорхой ХЭШИЙГ мэдэж байж л шалгана (жагсаах эрхгүй тул
    //     бүртгэлтэй хаягуудыг цуглуулж авах боломжгүй).
    //   • create: зөвхөн kind + at, хэш нь 64 тэмдэгт. Байгаа баримтыг
    //     дарж бичих боломжгүй (update/delete зөвхөн админд).
    match /reg_index/{hash} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if hash.size() == 64
        && request.resource.data.keys().hasOnly(['kind','at'])
        && request.resource.data.kind in ['email','phone'];
      allow update, delete: if isAdmin();
    }

    // Захиалагдсан цаг (PII биш) — нийтэд харагдах, зөвхөн энэ нэг баримт.
    // Зөвхөн 'slots' массивыг зөвшөөрч, хэмжээг хязгаарлана.
    match /public/taken_slots {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['slots'])
        && request.resource.data.slots is list
        && request.resource.data.slots.size() <= 1000;
    }

    // Хуудас үзэлтийн хэмжилт — өдөр тутмын нэгтгэсэн тоолуур (analytics.js бичнэ).
    //   • Хэн ч ӨСГӨНӨ (зочин хуудас нээхэд), гэхдээ зөвхөн админ УНШИНА —
    //     сайтын урсгалын тоо нийтэд харагдах ёсгүй.
    //   • PII агуулахгүй: зөвхөн тоолуур ба ангиллын түлхүүр.
    //   • Түлхүүрийн тоог хязгаарлаж, хязгааргүй том баримт үүсгэхээс сэргийлнэ.
    match /analytics/{day} {
      allow read: if isAdmin();
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly([
             'day','views','visitors','pages','articles','refs','devices','browsers'
           ])
        && request.resource.data.day == day
        && request.resource.data.views is int
        && (!('visitors' in request.resource.data) || request.resource.data.visitors is int)
        && (!('pages'    in request.resource.data) || request.resource.data.pages.size()    <= 100)
        && (!('articles' in request.resource.data) || request.resource.data.articles.size() <= 400)
        && (!('refs'     in request.resource.data) || request.resource.data.refs.size()     <= 120)
        && (!('devices'  in request.resource.data) || request.resource.data.devices.size()  <= 10)
        && (!('browsers' in request.resource.data) || request.resource.data.browsers.size() <= 20);
      allow delete: if isAdmin();
    }

    // Админы жагсаалт — зөвхөн одоогийн админ унших/нэмэх/эрх хасах боломжтой
    match /admins/{uid} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validAdminDoc();
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // Бусад бүх зам — хаалттай
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
