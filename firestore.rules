rules_version = '2';

// =============================================================================
// KPI consulting — Firestore аюулгүй байдлын дүрэм (АЮУЛГҮЙ ХУВИЛБАР)
// =============================================================================
// Firebase консол → Firestore Database → Rules хэсэгт БҮГДИЙГ нь хуулж тавиад
// Publish дарна.
//
// Урьдчилсан нөхцөл:
//   1) Authentication → Email/Password идэвхжсэн, админ хэрэглэгч үүсгэсэн байх.
//   2) Эхний админыг Firestore-д "admins" коллекц үүсгэж, БАРИМТ (document)
//      ID нь тухайн админы UID байхаар нэг doc нэмнэ (ж: {ok:true}).
//      Дараагийн админыг админ хэсгээс нэмж болно.
//
// Логик:
//   • content/*      — нийтийн контент. Хэн ч УНШИНА, зөвхөн админ БИЧНЭ.
//   • submissions/*  — зочны хүсэлт/захиалга/бүртгэл (хувийн мэдээлэлтэй).
//                      Зочид зөвхөн ҮҮСГЭНЭ, зөвхөн админ УНШИХ/УСТГАНА.
//   • public/taken_slots — захиалагдсан цаг (огноо+цаг, PII биш). Хэн ч унших/бичих.
//   • admins/*       — админы UID жагсаалт. Зөвхөн одоогийн админ удирдана.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Тухайн хэрэглэгч админ мөн эсэх (admins коллекцид UID нь байгаа эсэх)
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validAdminDoc() {
      return request.resource.data.keys().hasOnly([
          'ok','email','name','createdBy','createdAt'
        ])
        && request.resource.data.ok == true;
    }

    // Нийтийн контент — хэн ч унших, зөвхөн админ засах
    match /content/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Зочны илгээлт (хувийн мэдээлэл) — зочид зөвхөн үүсгэх, зөвхөн админ унших/устгах.
    // Спам/хог өгөгдлөөс сэргийлж kind болон талбаруудыг баталгаажуулна.
    match /submissions/{doc} {
      allow create: if request.resource.data.kind in ['quote', 'booking', 'user']
        && request.resource.data.keys().hasOnly([
             'kind','at','name','email','phone','org',
             'product','productKey','answers','date','time','paid','role'
           ])
        && (!('answers' in request.resource.data) || request.resource.data.answers.size() <= 40);
      // QPay худалдан авалтын бүртгэл — админд харагдах жагсаалт.
      // АНХААР: жинхэнэ эх сурвалж нь QPay merchant portal; энд зочин бичдэг
      // тул маргаантай тохиолдолд QPay дээрх гүйлгээгээр тулгаж шалгана.
      allow create: if request.resource.data.kind == 'payment'
        && request.resource.data.keys().hasOnly([
             'kind','at','invoiceId','paymentId','amount','product',
             'name','email','phone'
           ])
        && request.resource.data.invoiceId is string
        && request.resource.data.invoiceId.size() <= 64
        && request.resource.data.amount is number;
      // Мэдээллийн захиалга — зөвхөн и-мэйл хаяг (хамгийн бага өгөгдөл)
      allow create: if request.resource.data.kind == 'subscribe'
        && request.resource.data.keys().hasOnly(['kind','at','email'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 200;
      allow create: if isAdmin()
        && request.resource.data.kind == 'crm'
        && request.resource.data.keys().hasOnly([
             'kind','at','contactId','activityType','subject','message',
             'status','occurredAt','byName','byEmail'
           ])
        && request.resource.data.contactId is string
        && request.resource.data.activityType in ['email','call','note','status']
        && (!('subject' in request.resource.data) || request.resource.data.subject is string)
        && (!('message' in request.resource.data) || request.resource.data.message is string);
      allow read, update, delete: if isAdmin();
    }

    // Захиалагдсан цаг (PII биш) — нийтэд харагдах, зөвхөн энэ нэг баримт.
    // Зөвхөн 'slots' массивыг зөвшөөрч, хэмжээг хязгаарлана.
    match /public/taken_slots {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['slots'])
        && request.resource.data.slots is list
        && request.resource.data.slots.size() <= 1000;
    }

    // Админы жагсаалт — зөвхөн одоогийн админ унших/нэмэх/эрх хасах боломжтой
    match /admins/{uid} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validAdminDoc();
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // Бусад бүх зам — хаалттай
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
